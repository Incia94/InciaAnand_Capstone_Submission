# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=your_key_here
MODEL_NAME=meta-llama/llama-3.1-8b-instruct
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PATH=./storage/chroma
CHROMA_COLLECTION=kb_chunks
DATABASE_URL=sqlite:///./storage/decisions.db
LOG_LEVEL=INFO
CONFIDENCE_THRESHOLD=0.80
DOCS_PATH=./data/documentation.json
CHUNK_STRATEGY=document
RETRIEVAL_BACKEND=hybrid
RETRIEVAL_CONFIG=./storage/retrieval.json
CLASSIFIER_PATH=./storage/models/classifier.joblib
TRAIN_DATA=./data/development_tickets.json
ROUTING_CONFIG=./storage/routing.json
ROUTING_COST_RATIO=5
GENERATOR=llm
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT=30
LLM_CACHE=1
LLM_CACHE_DIR=./storage/llm_cache
GUARDRAIL_SUPPORT_THRESHOLD=0.45
KILL_SWITCH=0
KILL_SWITCH_FILE=./storage/KILL_SWITCH
API_HOST=127.0.0.1
API_PORT=8000
ANONYMIZED_TELEMETRY=False

# --- Search: dense (meaning) + lexical (wording) combined; share given to dense
HYBRID_DENSE_WEIGHT=0.7
# --- Findability: intent-guided search for near misses (on | off | auto = follow the data at ROUTING_COST_RATIO)
INTENT_HINT=on
# --- Data residency: regions whose ticket text is never sent to an external model (comma list, e.g. europe)
LLM_BLOCKED_REGIONS=
# --- Escalations get a cited draft reply for the agent (on | off)
AGENT_DRAFTS=on
# --- Cost control: model calls allowed per rolling hour (0 = no cap); over it, replies are built without a model
LLM_HOURLY_CALL_BUDGET=600
# Cirrus AI engine: search, tiers and channels
LEXICAL_BM25_WEIGHT=0.3      # share of BM25 in the keyword part of hybrid search (0 = TF-IDF only)
ROLLOUT_PHASE=3              # 1 API docs + agent copilot; 2 adds live chat; 3 adds email and forum
CHANNEL_POLICY=channel       # "uniform" treats every channel like live chat (for comparison)

# Review before sending: "review" holds every reply for a person to approve (python -m src.review),
# "auto" sends replies that pass every check. Escalations always wait for an agent.
REPLY_MODE=review
# REVIEW_DB=./storage/reviews.db   # default: reviews.db next to the decision log

# Support resolution hub (src/hub.py): central storage, deduplication, formatting
# TICKETS_DB=./storage/tickets.db   # default: tickets.db next to the decision log
DEDUP_WINDOW_HOURS=72                # merge the same open problem from the same customer within this window
DEDUP_SIMILARITY=0.5                 # how alike two tickets must be to be the same problem (0-1)
DOCS_BASE_URL=https://docs.cloudserve.example/articles   # article links in formatted replies

# Support workspace sign-in (python -m src.staff demo | add): accounts with hashed passwords only
# STAFF_FILE=./storage/staff.json
# Demo accounts (marcus = supervisor; asha, sofia, ravi = agents), created on first use. Demo only.
DEMO_ACCOUNTS=on
# DEMO_PASSWORD=password
